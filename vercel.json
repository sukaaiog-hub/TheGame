{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "functions": {
    "api/status.js": { "maxDuration": 10 },
    "api/leaderboard.js": { "maxDuration": 10 },
    "api/config.js": { "maxDuration": 10 },
    "api/record-browser-match.js": { "maxDuration": 10 }
  },
  "headers": [
    {
      "source": "/api/status",
      "headers": [{ "key": "Cache-Control", "value": "s-maxage=10, stale-while-revalidate=30" }]
    },
    {
      "source": "/api/leaderboard",
      "headers": [{ "key": "Cache-Control", "value": "s-maxage=10, stale-while-revalidate=30" }]
    },
    {
      "source": "/api/config",
      "headers": [{ "key": "Cache-Control", "value": "s-maxage=60, stale-while-revalidate=300" }]
    }
  ]
}
